# Sutradhar Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local to Git or expose secrets in version control.

# YouTube Data API v3 (OAuth2 Desktop Client)
YOUTUBE_CLIENT_ID="your-google-cloud-oauth-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your-google-cloud-oauth-client-secret"
YOUTUBE_REFRESH_TOKEN="your-production-oauth-refresh-token"

# ElevenLabs Speech Synthesis API
ELEVENLABS_API_KEY="your-elevenlabs-api-key"
