/* Sutradhar Video Engine — Proscenium & Puppet Master Stylesheet (v4.0) */

:root {
  --canvas-width: 1080px;
  --canvas-height: 1920px;

  /* Puppet Default Kinematic Variables */
  --trans-torso-x: 0px;
  --trans-torso-y: 0px;
  --rot-torso: 0deg;

  --rot-shoulder-l: 0deg;
  --rot-elbow-l: 0deg;
  --rot-wrist-l: 0deg;

  --rot-shoulder-r: 0deg;
  --rot-elbow-r: 0deg;
  --rot-wrist-r: 0deg;

  --rot-thigh-l: 0deg;
  --rot-calf-l: 0deg;
  --rot-thigh-r: 0deg;
  --rot-calf-r: 0deg;

  --rot-head: 0deg;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background-color: #050508;
  color: #fefefe;
  font-family: Georgia, 'Playfair Display', serif;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

#stage {
  position: relative;
  width: 1080px;
  height: 1920px;
  background: #0d0c14;
  overflow: hidden;
}

/* 1. Layering System */
#backdrops_layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 1080px;
  height: 1920px;
  z-index: 10;
}

.shot-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  visibility: hidden;
}

.shot-layer.active-shot {
  opacity: 1;
  visibility: visible;
}

.backdrop-wrapper, .foreground-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.backdrop-wrapper svg, .foreground-wrapper svg {
  width: 100%;
  height: 100%;
  display: block;
}

/* 2. Theatrical Proscenium Arch & Floor Shadow */
#proscenium_stage {
  position: absolute;
  top: 0;
  left: 0;
  width: 1080px;
  height: 1920px;
  pointer-events: none;
  z-index: 50;
}

/* Ground Ellipse Contact Shadow at Y = 1420px */
.stage-floor-shadow {
  position: absolute;
  top: 1380px;
  left: 100px;
  width: 880px;
  height: 120px;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(5, 4, 10, 0.75) 0%, rgba(5, 4, 10, 0) 70%);
  z-index: 25;
}

.proscenium-valance {
  position: absolute;
  top: 0;
  left: 0;
  width: 1080px;
  height: 120px;
  background: linear-gradient(180deg, #3d050c 0%, #730f1e 70%, #991b2e 90%, #d4af37 100%);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
  z-index: 52;
}

.proscenium-pillar {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 48px;
  background: linear-gradient(90deg, #1f0b0e 0%, #3d1419 40%, #1f0b0e 100%);
  border-right: 2px solid #d4af37;
  border-left: 2px solid #d4af37;
  z-index: 52;
}

.pillar-left {
  left: 0;
}

.pillar-right {
  right: 0;
}

/* 3. Puppet Rigs Standardized to 480 × 960px with transform-origin: 50% 100% */
#characters_layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 1080px;
  height: 1920px;
  z-index: 40;
}

.puppet-wrapper {
  position: absolute;
  top: 460px;
  left: 300px;
  width: 480px;
  height: 960px;
  transform-origin: 50% 100%;
  display: block;
}

.puppet-wrapper svg {
  width: 100%;
  height: 100%;
  display: block;
  overflow: visible;
}

/* 4. Subtitle Container (Bottom Center, Georgia/Garamond, Active Highlighting) */
#subtitle_container {
  position: absolute;
  bottom: 340px;
  left: 80px;
  right: 80px;
  min-height: 100px;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  z-index: 60;
  pointer-events: none;
}

.subtitle-line {
  font-family: 'Playfair Display', 'EB Garamond', Georgia, serif;
  font-size: 44px;
  font-weight: 700;
  line-height: 1.35;
  color: #fef3c7;
  text-shadow: 0 4px 12px rgba(0, 0, 0, 0.95), 0 2px 4px rgba(0, 0, 0, 0.85);
  max-width: 920px;
}

.sub-word {
  display: inline-block;
  margin: 0 6px;
  transform-origin: 50% 80%;
}

.sub-word.active {
  color: #ffffff;
  transform: scale(1.08);
  text-shadow: 0 0 16px rgba(251, 191, 36, 0.85), 0 4px 12px rgba(0, 0, 0, 0.9);
}

.sub-word.keyword, .sub-word.keyword-teal {
  color: #38bdf8;
  text-shadow: 0 0 12px rgba(56, 189, 248, 0.65), 0 2px 8px rgba(0, 0, 0, 0.9);
}

.sub-word.keyword-gold {
  color: #fbbf24;
  text-shadow: 0 0 14px rgba(251, 191, 36, 0.75), 0 2px 8px rgba(0, 0, 0, 0.9);
}

/* 5. Theatrical Velvet Curtains */
.curtain-stage {
  position: absolute;
  top: 0;
  left: 0;
  width: 1080px;
  height: 1920px;
  z-index: 70;
  pointer-events: none;
}

.curtain-panel {
  position: absolute;
  top: 0;
  width: 540px;
  height: 1920px;
  background: linear-gradient(90deg, #4d0a14 0%, #801020 50%, #4d0a14 100%);
  box-shadow: 0 0 40px rgba(0, 0, 0, 0.8);
}

.curtain-left {
  left: 0;
  transform-origin: 0% 50%;
}

.curtain-right {
  right: 0;
  transform-origin: 100% 50%;
}

/* 6. Props & VFX */
#props_layer, #vfx_layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 1080px;
  height: 1920px;
  pointer-events: none;
}

.prop-wrapper {
  position: absolute;
  z-index: 35;
}

.prop-wrapper svg {
  width: 100%;
  height: 100%;
  display: block;
}

.vfx-element {
  position: absolute;
  z-index: 45;
  opacity: 0;
}
